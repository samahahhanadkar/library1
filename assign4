#include <iostream>
using namespace std;

int main()
{
    int choice;
    int book[10];
    int n = 0;
    int id;

    do
    {
        cout << "\n1. Add Book";
        cout << "\n2. Display Books";
        cout << "\n3. Search Book";
        cout << "\n4. Exit";

        cout << "\nEnter choice: ";
        cin >> choice;

        if(choice == 1)
        {
            cout << "Enter Book ID: ";
            cin >> book[n];
            n++;
        }

        else if(choice == 2)
        {
            for(int i = 0; i < n; i++)
            {
                cout << book[i] << endl;
            }
        }

        else if(choice == 3)
        {
            cout << "Enter Book ID: ";
            cin >> id;

            for(int i = 0; i < n; i++)
            {
                if(book[i] == id)
                {
                    cout << "Book Found";
                }
            }
        }

        else if(choice == 4)
        {
            cout << "Exit";
        }

        else
        {
            cout << "Invalid choice";
        }

    } while(choice != 4);

    return 0;
}
