#include<iostream>
using namespace std;
int main()
{
  int books[5];
  cout<<"Enter 5 book Ids:\n";
  for(int i=0; i<5; i++)
  {
    cin>>books[i];
  }
   //Sorting
   for(int i=0; i<4; i++)
   {
     for (int j=0; j<4-i; j++)
     {
       if(books[j]>books[j+1])
       {
         int temp= books[j];

         books[j]= books[j];
         books[j+1]= temp;
       }
     }
   }
cout<<"\nBooks after sorting:\n";
for (int i=0; i<5; i++)
{
  cout<<books[i]<<"";
}
return 0;
}
